<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#DDE8F1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <!-- MENU -->
        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/menu"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- TITULO -->
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APP CONTROLADOR"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            >
            <!-- TEXTO INCLINACAO -->
            <TextView
                android:id="@+id/txtInc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INCLINAÇÃO"
                android:textStyle="bold"
                android:textColor="#5A35FF"
                android:textSize="22sp"
                android:layout_marginTop="30dp"
                android:layout_marginStart="120dp"
                app:layout_constraintTop_toBottomOf="@id/txtTitulo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/txtAlt"/>

            <!-- TEXTO ALTURA -->
            <TextView
                android:id="@+id/txtAlt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="120dp"
                android:layout_marginStart="250dp"
                android:text="ALTURA"
                android:textColor="#5A35FF"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtTitulo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <!-- SLIDER DE ARCO -->

            <!-- SLIDER VERTICAL -->
            <com.example.controladorproreab.ArcSliderView
                android:id="@+id/arcSlider"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_marginVertical="20dp"
                android:layout_marginStart="72dp"
                android:layout_marginTop="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtInc" />

            <com.example.controladorproreab.VerticalSliderView
                android:id="@+id/verticalSlider"
                android:layout_width="100dp"
                android:layout_height="300dp"
                android:layout_marginVertical="20dp"
                android:layout_marginStart="100dp"
                app:layout_constraintTop_toBottomOf="@id/txtAlt"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="70dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>